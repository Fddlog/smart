    <script>
        // Timer regressivo
        function updateTimer() {
            const timer = document.getElementById('countdown');
            let [hours, minutes, seconds] = timer.innerHTML.split(':').map(Number);

            setInterval(() => {
                if (seconds === 0) {
                    if (minutes === 0) {
                        if (hours === 0) return;
                        hours--;
                        minutes = 59;
                    } else {
                        minutes--;
                    }
                    seconds = 59;
                } else {
                    seconds--;
                }

                timer.innerHTML = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            }, 1000);
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Inicializar timer
            updateTimer();

            // Gerenciar miniaturas
            const thumbnails = document.querySelectorAll('.thumbnail-gallery img');
            const carousel = new bootstrap.Carousel(document.getElementById('productCarousel'), {
                interval: 5000
            });

            thumbnails.forEach(thumb => {
                thumb.addEventListener('click', function() {
                    thumbnails.forEach(t => t.classList.remove('active'));
                    this.classList.add('active');
                    carousel.to(parseInt(this.dataset.slide));
                });
            });

            // Atualizar miniatura ativa quando o carousel mudar
            document.getElementById('productCarousel').addEventListener('slid.bs.carousel', function(e) {
                thumbnails.forEach(t => t.classList.remove('active'));
                thumbnails[e.to].classList.add('active');
            });

            // Formulário de checkout
            document.getElementById('checkoutForm').addEventListener('submit', function(e) {
                e.preventDefault();
                alert('Pedido realizado com sucesso! Em breve você receberá as instruções de pagamento por e-mail.');
                var modal = bootstrap.Modal.getInstance(document.getElementById('checkoutModal'));
                modal.hide();
            });
        });
    </script>
</body>
</html>
